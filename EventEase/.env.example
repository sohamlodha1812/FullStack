# ============================================================
# EventEase — Environment Variables Template
# ============================================================
# 1. Copy this file and rename it to .env
# 2. Fill in your actual values
# 3. Never commit .env to Git — it is already in .gitignore
# ============================================================

# Port the server will listen on
PORT=3000

# MongoDB connection string
# Get this from MongoDB Atlas → Connect → Drivers
# Example: mongodb+srv://username:password@cluster.mongodb.net/eventease
MONGO_URI=your_mongodb_connection_string_here

# Admin dashboard password (choose something strong)
ADMIN_PASSWORD=change_this_password

# A long random string used to sign session cookies
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
